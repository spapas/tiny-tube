# Tiny Tube config. Copy to .env and adjust.
# .env is auto-loaded at startup (gitignored). Explicit env vars always win over .env.
# Lines starting with # are ignored. Values may be 'single' or "double" quoted.

# Dir holding videos/{id}/... (must match Nginx alias in Go+Nginx mode)
VIDEO_DIR=videos

# Full bind addr. Local dev stays loopback-only; use 0.0.0.0:8080 for LAN.
ADDR=127.0.0.1:8081

# Compat: used as 127.0.0.1:$PORT only when ADDR is unset.
# PORT=8081

# Metadata backend: sqlite (default) or fs (legacy meta.json per video).
# Video blobs always stay on disk under VIDEO_DIR/{id}/ either way.
STORE=sqlite

# SQLite file. Default is <VIDEO_DIR>/tiny-tube.db when unset.
# DB_PATH=videos/tiny-tube.db

# BasicAuth for GET /upload + POST /api/upload (viewers stay open).
UPLOAD_USER=admin
UPLOAD_PASS=changeme

# Windows custom ffmpeg path fallback (used only when ffmpeg is not in PATH).
# FFMPEG_BIN=
