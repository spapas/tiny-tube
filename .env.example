# Tiny Tube config. Copy to .env and adjust.
# .env is auto-loaded at startup (gitignored). Explicit env vars always win over .env.
# Lines starting with # are ignored. Values may be 'single' or "double" quoted.

# Dir holding videos/{id}/... (Nginx proxies media through Go).
VIDEO_DIR=videos

# Full bind addr. Local dev stays loopback-only; use 0.0.0.0:8081 for LAN.
ADDR=127.0.0.1:8081

# Compat: used as 127.0.0.1:$PORT only when ADDR is unset.
# PORT=8081

# Metadata backend: sqlite (default) or fs (legacy meta.json per video).
# Video blobs always stay on disk under VIDEO_DIR/{id}/ either way.
STORE=sqlite

# SQLite file. Default is <VIDEO_DIR>/tiny-tube.db when unset.
# DB_PATH=videos/tiny-tube.db

# First administrator. On a fresh user table the server creates ADMIN_USER with
# ADMIN_PASS (required: nonempty, not "changeme"); afterwards ADMIN_* is ignored
# and users are managed at /admin. Roles: admin, editor (upload+edit), viewer.
ADMIN_USER=admin
ADMIN_PASS=
# Required: choose a nonempty strong password; "changeme" is rejected.

# Login source: local, ldap or both (LDAP first, local fallback).
# Local users always work in local mode; LDAP users are provisioned on first
# login as viewers until an administrator grants a role.
AUTH_MODE=local

# Session cookies are HttpOnly + SameSite=Lax; set true behind HTTPS (Nginx).
COOKIE_SECURE=false

# LDAP directory (used when AUTH_MODE is ldap or both). Direct user bind by
# default; set LDAP_BIND_DN (+password) and LDAP_SEARCH_BASES for subtree search.
LDAP_ADDR=ldap://localhost:389
LDAP_BASE_DN=dc=example,dc=com
# LDAP_BIND_DN=
# LDAP_BIND_PASSWORD=
# LDAP_SEARCH_BASES=ou=people,dc=example,dc=com
LDAP_USER_FILTER=(uid=%s)
# LDAP_USER_DN=uid=%s,ou=people,dc=example,dc=com
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_FIRST_NAME=givenName
LDAP_ATTR_LAST_NAME=sn
LDAP_ALWAYS_UPDATE=true

# Explicit FFmpeg path/name takes precedence over PATH; invalid overrides fail startup.
# FFMPEG_BIN=

# Whole multipart request cap (2 GiB) and maximum concurrent conversion workers.
MAX_UPLOAD_BYTES=2147483648
TRANSCODE_WORKERS=1

# All protected-route requests per minute per source IP, before authentication.
# Behind a proxy, clients share the proxy IP bucket; tune with an edge IP limit.
AUTH_REQUESTS_PER_MINUTE=60

# Total upload and conversion deadlines (30 minutes). Expired conversions fail.
UPLOAD_TIMEOUT_SECONDS=1800
TRANSCODE_TIMEOUT_SECONDS=1800
